---
// The shell for the pages outside Starlight: the landing page (/) and /benchmarks/. The
// theme shares Starlight's `starlight-theme` storage key, so a choice made here holds on
// /docs/ and back.
import "../styles/landing.css";
import { REPO_URL } from "../lib/llms";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = new URL("/", Astro.site).href;
const ogImage = new URL("/logo-1024.png", Astro.site).href;
const path = Astro.url.pathname;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "FlareDispatch",
      url: origin,
      description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Cloudflare Workers",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      codeRepository: REPO_URL,
    },
    { "@type": "WebSite", name: "FlareDispatch", url: origin },
  ],
};

const nav = [
  { href: "/docs/", label: "Docs", current: path.startsWith("/docs") },
  { href: "/docs/runs/", label: "Runs", current: false, secondary: true },
  { href: "/benchmarks/", label: "Benchmarks", current: path.startsWith("/benchmarks") },
];

const footer = [
  {
    heading: "Get started",
    links: [
      { href: "/docs/", label: "Overview" },
      { href: "/docs/actions/flare-dispatch-action/", label: "Offload a job" },
      { href: "/docs/actions/deploy-dispatcher-action/", label: "Deploy a Dispatcher" },
      { href: "/docs/runs/", label: "Run catalog" },
    ],
  },
  {
    heading: "Reference",
    links: [
      { href: "/docs/substrate/", label: "Substrate" },
      { href: "/docs/reference/substrate-contract/", label: "API reference" },
      { href: "/benchmarks/", label: "Benchmarks" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FlareDispatch" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Before first paint: the stored theme, else the system's.
      (function () {
        var theme;
        try {
          theme = localStorage.getItem("starlight-theme");
        } catch (_) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-header__brand" aria-label="FlareDispatch home">
          <svg class="site-header__brand-mark" aria-hidden="true" viewBox="0 0 32 32">
            <path d="M8 30 C11 24 15 21 20 18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            <path d="M21 2 L23 10 L21 18 L19 10 Z M13 10 L21 8 L29 10 L21 12 Z" fill="currentColor" />
          </svg>
          FlareDispatch
        </a>
        <nav class="site-header__nav" aria-label="Primary">
          {
            nav.map((n) => (
              <a href={n.href} class:list={[n.secondary && "nav-secondary"]} aria-current={n.current ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
          <a href={REPO_URL} class="nav-secondary" target="_blank" rel="noreferrer noopener">GitHub ↗</a>
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme" type="button">
            <svg class="theme-toggle__moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5z" />
            </svg>
            <svg class="theme-toggle__sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8" cy="8" r="2.6" />
              <path d="M8 1v2M8 13v2M1 8h2M13 8h2M2.7 2.7l1.4 1.4M11.9 11.9l1.4 1.4M2.7 13.3l1.4-1.4M11.9 4.1l1.4-1.4" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          {
            footer.map((col) => (
              <div class="site-footer__col">
                <h4>{col.heading}</h4>
                <ul>
                  {col.links.map((l) => (
                    <li>
                      <a href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="site-footer__stamp">
          <span>BYOC CI/CD on Cloudflare</span>
          <span>repo / <a href={REPO_URL} target="_blank" rel="noreferrer noopener">{REPO_URL.replace("https://", "")}</a></span>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("starlight-theme", next);
          } catch (_) {}
        });
      })();
    </script>
  </body>
</html>
