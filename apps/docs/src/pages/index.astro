---
import { Code } from "@astrojs/starlight/components";
import Landing from "../layouts/Landing.astro";
import HeroDiagram from "../components/landing/HeroDiagram.astro";
import Diagram from "../components/landing/Diagram.astro";
import { fencedLease, lifecycle, placement } from "../components/landing/diagrams";

const DESCRIPTION =
  "Local-first CI/CD in your own Cloudflare account. Cloudflare is the control plane; executions run first on hardware you own and spill to Cloudflare Containers, with required checks going on to AWS while Containers are unavailable, under a spend guard and a fenced lease. Runs are typed Effect programs, not YAML.";

const why = [
  {
    id: "01.01 / Warm state",
    title: "Owned hardware runs first",
    body: "Dependencies, build outputs, browsers and model weights stay on the device's disk between runs, with R2 as the second cache level. A warm job needs fewer minutes, not only cheaper ones.",
  },
  {
    id: "01.02 / Ceiling",
    title: "A spend ceiling no cloud meter offers",
    body: "Owned capacity is fixed, so a runaway retry loop or a fan-out bug costs queue time, not money. Cloud spill and hosted model tokens run under the spend guard.",
  },
  {
    id: "01.03 / Floor",
    title: "The cloud is the floor, not the default",
    body: "Cloudflare Containers take every guaranteed execution that owned hardware cannot claim before its deadline; AWS takes required (P1) checks while the Containers breaker is open. Releases and fork PRs run in the cloud by rule.",
  },
];

const wins = [
  { dim: "Warm state: deps, builds, browsers", owned: "Stays on local disk between runs", cloud: "Starts cold every execution", verdict: "Owned" },
  { dim: "Apple-platform builds", owned: "Native macOS guests", cloud: "Not available", verdict: "Owned" },
  { dim: "Large memory, local models", owned: "Unified memory holds model weights", cloud: "Fixed memory per instance", verdict: "Owned" },
  { dim: "Worst-case month", owned: "Fixed by the hardware", cloud: "Bounded by the spend guard", verdict: "Owned" },
  { dim: "Availability", owned: "One machine: sleep, updates, power", cloud: "Provider SLA", verdict: "Cloud" },
  { dim: "Burst fan-out", owned: "Fixed slot count", cloud: "Elastic up to the pool cap", verdict: "Cloud" },
  { dim: "Untrusted code (fork PRs)", owned: "Shares hardware with personal credentials", cloud: "Disposable container", verdict: "Cloud only" },
  { dim: "Release provenance", owned: "Device-signed", cloud: "Cold build, countersigned, logged", verdict: "Cloud" },
];

const rules = [
  {
    title: "Fork PR code never runs on owned hardware.",
    body: "Owned devices run only code from people with write access. Stranger code runs in a disposable cloud container.",
  },
  {
    title: "Confidential-compute code never leaves owned hardware.",
    body: "A confidential-compute repository has no cloud floor. With no eligible managed device, its execution waits until its deadline, then concludes failure. A fork-PR, tag or P0 request in such a repository has no eligible executor and concludes failure (placement: no eligible executor) at intake, without waiting.",
  },
  {
    title: "Unclassified data never reaches a hosted model.",
    body: "Confidential-model is the default: model calls start in the job VM on an owned device, and the cloud floor runs the check without model calls.",
  },
  {
    title: "Releases build in the cloud.",
    body: "P0 executions run on Cloudflare Containers from admission, cold from the commit, with provenance under the control plane's key. A release-matrix job that needs macOS runs on GitHub Actions instead.",
  },
  {
    title: "Local-first is a delayed cloud claim, not a race.",
    body: "The placement row holds a local entry claimable at once and a cloud entry eligible at the claim deadline. The first compare-and-set from queued to leased wins the epoch and every later claim at that epoch is refused, so one copy runs; a reclaim increments the epoch.",
  },
];

const classes = [
  { cls: "P0", name: "release", runs: "Release and deploy runs", deadline: "None: cloud at admission", outcome: "failure, named reason" },
  { cls: "P1", name: "required", runs: "Runs the target branch's ruleset requires", deadline: "60 s", outcome: "Waits until deadline_at, then failure" },
  { cls: "P2", name: "interactive", runs: "pr-review, self-heal-pr and gating runs whose check is not required", deadline: "5 min", outcome: "failure at its queue age" },
  { cls: "P3", name: "batch", runs: "Crons, improve-pr, triage", deadline: "Half the run's period", outcome: "Deferred to the next tick" },
];

const lines = [
  { cls: "P3", at: "P3 line", note: "stops first", pct: 38 },
  { cls: "P2", at: "B − R0 − R1", note: "keeps the required reserve", pct: 68 },
  { cls: "P1", at: "B − R0", note: "required checks and ops runs", pct: 88 },
  { cls: "P0", at: "B", note: "releases spend to the budget", pct: 100 },
];

const failures = [
  { failure: "Sleep, reboot, OS update", detect: "Heartbeat stops", effect: "P1 and P2 work restarts in the cloud; confidential-compute work waits for another device; batch work requeues locally" },
  { failure: "ISP or power loss", detect: "Heartbeat stops", effect: "Same; batch work waits for the device or its staleness point" },
  { failure: "Control-plane deploy", detect: "Sockets drop", effect: "The agent reconnects; lease TTLs count from the restart; results replay from its outbox" },
  { failure: "Job stalled, agent alive", detect: "Progress timeout", effect: "Reclaimed like a dead device" },
  { failure: "Device returns with stale work", detect: "Epoch mismatch, revoked token", effect: "Result discarded; stale writes blocked" },
];

const routing = [
  { step: "Confidentiality", body: "A confidential-model or confidential-compute repository never calls a hosted model, and never falls back to one." },
  { step: "Task tier", body: "Judgment calls (review, plan, write code) go hosted. Bulk calls (classify, extract, summarize, embed) run locally when their input is on owned hardware." },
  { step: "Data location", body: "A bulk call inside a spilled cloud step uses a small hosted model instead of pulling data back to the device." },
  { step: "Budget", body: "Hosted calls reserve their allowance inside the class line. At the line, bulk calls drop to a local model and judgment calls conclude failure, budget." },
];

const tiers = [
  { tier: "device-signed", proves: "This attested device produced it, unaltered since", use: "Test verdicts, logs, internal artifacts" },
  { tier: "platform", proves: "These inputs and this process; the job could not reach the signer", use: "PR artifacts, preview deploys" },
  { tier: "reproduced", proves: "The source produces exactly this output: a cold rebuild on a dedicated attested device with digests equal to the cloud build's", use: "Releases, published packages and images" },
];

const recipes = [
  {
    id: "08.01 / Gate",
    title: "check and oxlint",
    body: "One command per check run in a fresh VM or container. The exit code maps to the conclusion, and the log links from the check.",
    href: "/docs/runs/gate/",
  },
  {
    id: "08.02 / Gate",
    title: "Test shards and job matrices",
    body: "offload-test and the job-matrix primitive fan a suite out as child executions whose class never ranks above the parent's.",
    href: "/docs/runs/gate/",
  },
  {
    id: "08.03 / Agentic",
    title: "pr-review",
    body: "Local embeddings retrieve context and a local pre-pass drops style nits; a hosted judgment model writes the one review the author reads.",
    href: "/docs/runs/agentic/",
  },
  {
    id: "08.04 / Agentic",
    title: "self-heal-pr, improve-pr, spec-drift-pr",
    body: "The agent edits in a job VM that holds no GitHub token. The control plane applies the staged write after a path allowlist and a secret scan.",
    href: "/docs/runs/agentic/",
  },
  {
    id: "08.05 / Agentic",
    title: "ci-triage-pr",
    body: "A bulk model classifies the failed job from its logs; a judgment model writes the fix proposal.",
    href: "/docs/runs/agentic/",
  },
  {
    id: "08.06 / Rule",
    title: "The trifecta rule",
    body: "No agentic run holds private data, untrusted content and outbound communication at once. Every agentic recipe is reviewed against it.",
    href: "/docs/runs/agentic/",
  },
];

const bets = [
  {
    statement: "Cloudflare <strong>schedules</strong>; devices execute.",
    body: "The control plane owns every guarantee, deadline, spill and check. A device's local scheduler places only unguaranteed work (dev loops, agent swarms, rehearsals) inside a capacity lease, so a device's uptime never becomes the system's.",
  },
  {
    statement: "<strong>Queue</strong>, then fail.",
    body: "A budget, capacity, deadline or halt outcome never concludes success or neutral. Every red check carries the reason it is red.",
  },
  {
    statement: "Runs are <strong>typed programs</strong>, not YAML.",
    body: "Effect v4 programs on mameko's workflow engine: Schema-typed inputs and outputs, journaled steps, tagged errors. A run tests against a memory engine and a fake executor, with no container.",
  },
  {
    statement: "BYOC <strong>by construction</strong>.",
    body: "Each organization deploys its own control plane into its own Cloudflare account and registers its own devices. There is no multi-tenant operator and no hosted service to trust.",
  },
];

const runTs = `// runs/check.ts, condensed
export const check = defineRun(
  {
    name: "check",
    version: "1.0.0",
    input: CheckInput, // Schema.Struct({ repo, sha, entry }); entry is the repo manifest's check entry
    requires: ["Workspace", "Exec", "Artifact"],
    limits: { maxDurationSec: 4500, qosClass: "P1", qosCeiling: "P1" },
    triggers: [pullRequestTrigger], // DispatchEvent => Option<CheckInput>
  },
  (input) =>
    Effect.gen(function* () {
      const { dir } = yield* checkout({ repo: input.repo, sha: input.sha });
      const result = yield* exec({ cwd: dir, command: input.entry.command, timeoutSec: input.entry.timeoutSec });
      yield* artifact.upload({ name: \`\${input.entry.label}.log\`, path: result.logPath });
      if (result.exitCode !== 0) {
        return yield* Effect.fail(new CheckFailed({ reason: \`exit: \${result.exitCode}\` }));
      }
    }),
);`;

const policyJson = `{
  "default": { "mode": "local-first" },
  "rules": [
    { "match": { "trigger": "fork-pr" }, "mode": "cloud-only" },
    { "match": { "branch": "refs/tags/*" }, "mode": "cloud-only", "authority": "cloud" },
    { "match": { "repo": "org/confidential-*" }, "constraint": "confidential-compute" },
    { "match": { "trigger": "local" }, "mode": "local-only", "authority": "advisory" }
  ]
}`;

const snippets = [
  {
    id: "run",
    label: "check.ts",
    lang: "ts" as const,
    code: runTs,
    blurb: "A run is a program: a typed contract, journaled steps, a tagged failure that maps to the check's conclusion. The same program runs on every executor.",
    href: "/docs/run-model/",
  },
  {
    id: "policy",
    label: "placement policy",
    lang: "json" as const,
    code: policyJson,
    blurb: "Placement is configuration: the first matching rule picks the mode and which result is authoritative. Moving a run between modes changes no code.",
    href: "/docs/profile/",
  },
];
---

<Landing title="FlareDispatch — local-first CI/CD in your own Cloudflare account" description={DESCRIPTION}>
  <section class="hero">
    <div class="container">
      <div class="hero__meta">
        <span class="section-marker reveal" data-delay="1">§00 / Manifest</span>
        <span class="section-marker reveal" data-delay="1">BYOC · local-first · open source</span>
      </div>
      <div class="hero__grid">
        <div>
          <h1 class="hero__title reveal" data-delay="2">
            Run CI on <em>hardware you&#160;own</em>. Spill to the cloud on a deadline.
          </h1>
          <p class="hero__sub reveal" data-delay="3">
            FlareDispatch is local-first CI/CD that you deploy into your own Cloudflare account. Cloudflare is the
            control plane: it verifies each trigger, classifies and meters the execution, leases it to an executor
            and posts the verdict to GitHub. Executions run first on hardware you own (a Mac running
            mameko's device executor, one VM per job) and spill to Cloudflare Containers, with required checks going on to AWS, when owned
            capacity cannot meet the deadline.
          </p>
          <div class="hero__cta reveal" data-delay="4">
            <a class="btn" href="/docs/">Read the specs</a>
            <a class="btn btn--ghost" href="/docs/architecture/">Architecture</a>
            <a class="btn btn--ghost" href="/docs/adr/">Decision records</a>
          </div>
        </div>
        <div class="reveal" data-delay="3">
          <HeroDiagram />
        </div>
      </div>
    </div>
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§01 / Why local-first</span>
        <h2>The real cost of CI is cold state, not CPU.</h2>
        <p class="section-lede">
          An ephemeral runner re-downloads dependencies, rebuilds unchanged packages, re-installs browsers and re-loads
          model weights on every job. A machine that keeps that state hot beats it on those jobs, and loses on burst
          fan-out, untrusted code and anything that needs an uptime promise. FlareDispatch routes each kind of work by
          rule.
        </p>
      </div>
      <div class="tenets__grid">
        {
          why.map((v) => (
            <article class="tenet">
              <span class="tenet__id">{v.id}</span>
              <h3 class="tenet__title">{v.title}</h3>
              <p class="tenet__rationale">{v.body}</p>
            </article>
          ))
        }
      </div>
      <div class="compare__wrap compare__wrap--spaced">
        <table class="compare__table">
          <caption class="sr-only">Where owned hardware wins and where the cloud wins</caption>
          <thead>
            <tr>
              <th>Dimension</th>
              <th>Owned hardware</th>
              <th>Cloudflare Containers</th>
              <th>Runs on</th>
            </tr>
          </thead>
          <tbody>
            {
              wins.map((w) => (
                <tr>
                  <td>{w.dim}</td>
                  <td>{w.owned}</td>
                  <td>{w.cloud}</td>
                  <td class:list={[w.verdict === "Owned" ? "compare__yes" : "compare__cloud"]}>{w.verdict}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§02 / Placement</span>
        <h2>Placement rules hold before any deadline does.</h2>
        <p class="section-lede">
          Each execution carries a class and a claim deadline from intake. Placement constraints remove executors from
          the eligible set first; the deadline then decides between owned hardware and the cloud.
        </p>
      </div>
      <div class="split">
        <Diagram
          id="placement"
          source={placement}
          width={520}
          caption="Fig. 1 · constraints first, then the claim deadline"
        />
        <div>
          <ol class="rules">
            {
              rules.map((r, i) => (
                <li class="rule-item">
                  <span class="rule-item__num">§02.0{i + 1}</span>
                  <div>
                    <p class="rule-item__title">{r.title}</p>
                    <p class="rule-item__body">{r.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="more">
            <a href="/docs/profile/">Profile and placement →</a>
            <a href="/docs/isolation-egress/">Isolation and egress →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§03 / Queue, then fail</span>
        <h2>No budget or capacity outcome turns a check green.</h2>
        <p class="section-lede">
          GitHub counts a <code>neutral</code> conclusion as passing for a required check. So an execution that meets its
          class line or an empty pool queues for a claim until its deadline (a P2 until its queue age), then concludes
          <code>failure</code> with a named reason: budget, capacity or deadline. An operator halt concludes it
          <code>failure</code> with reason halt, and supersession concludes <code>cancelled</code>.
        </p>
      </div>
      <div class="split split--reverse">
        <div class="compare__wrap">
          <table class="compare__table">
            <caption class="sr-only">QoS classes, their claim deadlines on owned hardware, and their outcome at the line</caption>
            <thead>
              <tr>
                <th>Class</th>
                <th>Runs</th>
                <th>Local claim deadline</th>
                <th>At its line or deadline</th>
              </tr>
            </thead>
            <tbody>
              {
                classes.map((c) => (
                  <tr>
                    <td>
                      <span class="class-tag">{c.cls}</span> <code>{c.name}</code>
                    </td>
                    <td>{c.runs}</td>
                    <td>{c.deadline}</td>
                    <td>{c.outcome}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="more">
            <a href="/docs/profile/">Classes and admission →</a>
            <a href="/docs/github-output/">GitHub output →</a>
          </p>
        </div>
        <Diagram
          id="lifecycle"
          source={lifecycle}
          width={560}
          caption="Fig. 2 · a guaranteed execution, intake to verdict"
        />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§04 / Spend guard</span>
        <h2>Admission keeps committed spend under the budget; a settle above its hold pages.</h2>
        <p class="section-lede">
          Cloudflare has no account-level spending cap. The spend guard admits an execution only when its hold (the
          executor's rate over the window to its deadline plus the settle margin, plus its model allowance and network
          estimate) fits under its class line.
          Month-to-date spend counts settled cost plus open reservations. Execution on owned hardware costs no container
          time; its hosted model tokens still count.
        </p>
      </div>
      <div class="split">
        <figure class="lines" aria-labelledby="lines-caption">
          <ol class="lines__list">
            {
              lines.map((l) => (
                <li class="lines__row">
                  <span class="lines__cls">{l.cls}</span>
                  <span class="lines__track">
                    <span class="lines__bar" style={`width: ${l.pct}%`}>
                      <code>{l.at}</code>
                    </span>
                  </span>
                  <span class="lines__note">{l.note}</span>
                </li>
              ))
            }
          </ol>
          <figcaption id="lines-caption">
            Fig. 3 · nested class lines on one meter, P3 ≤ P2 ≤ P1 ≤ P0 = B. R0 reserves release spend; R1 covers
            required checks through a fleet-down spill and is recomputed daily. Widths are illustrative.
          </figcaption>
        </figure>
        <div>
          <ul class="facts">
            <li>
              <strong>Holds, then settle.</strong> Admission reserves the worst case; settling replaces the reservation with
              the metered cost in one D1 batch.
            </li>
            <li>
              <strong>Burn lanes.</strong> Nested hourly lanes cap the summed list rate each class may admit, so a fleet-down
              burst cannot spend the month in an afternoon.
            </li>
            <li>
              <strong>Operator halt.</strong> One control stops admission for a scope; the claim statement reads it.
            </li>
          </ul>
          <aside class="formal">
            <span class="formal__eyebrow">Formal model</span>
            <p>
              The spend, placement, outbox, staged-write and fencing kernels have Lean 4 models. Differential random
              testing runs the TypeScript kernel against the compiled Lean oracle, so the theorem and the code that
              admits executions answer the same way.
            </p>
            <p class="more">
              <a href="/docs/spend/">Spend →</a>
              <a href="/docs/adr/0018-formal-models/">Formal models →</a>
            </p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§05 / Fenced leases</span>
        <h2>A dead Mac costs time, never a wrong check.</h2>
        <p class="section-lede">
          An executor holds an execution under a lease for one epoch, renewed by heartbeat. When the heartbeat stops, the
          control plane reclaims the lease, increments the epoch and restarts the execution elsewhere under a hold
          re-admitted to cover the earlier epochs and the new executor's window. It accepts a result only at the current epoch, mints credentials per lease and revokes them on reclaim,
          and keys log and cache writes by epoch, so a device that wakes late cannot overwrite the cloud's work.
        </p>
      </div>
      <div class="split">
        <Diagram
          id="fenced-lease"
          source={fencedLease}
          width={560}
          caption="Fig. 4 · reclaim, restart, reject the stale result"
        />
        <div class="compare__wrap">
          <table class="compare__table">
            <caption class="sr-only">Device failures, how the control plane detects them, and their effect</caption>
            <thead>
              <tr>
                <th>Failure</th>
                <th>Detected by</th>
                <th>Effect</th>
              </tr>
            </thead>
            <tbody>
              {
                failures.map((f) => (
                  <tr>
                    <td>{f.failure}</td>
                    <td>{f.detect}</td>
                    <td>{f.effect}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p class="more">
            <a href="/docs/executors/">Executors →</a>
            <a href="/docs/executor-protocol/">Executor protocol →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§06 / Models and provenance</span>
        <h2>Move the model to the data, and prove where a build ran.</h2>
      </div>
      <div class="split split--even">
        <div>
          <h3 class="sub-head">Model routing</h3>
          <p class="sub-lede">
            Most AI steps read large inputs (logs, diffs, traces) and write small outputs (a verdict, a comment). Each
            call is placed in order:
          </p>
          <ol class="steps">
            {
              routing.map((r) => (
                <li>
                  <span>
                    <strong>{r.step}.</strong> {r.body}
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="more"><a href="/docs/model-gateway/">Model gateway →</a></p>
        </div>
        <div>
          <h3 class="sub-head">Provenance tiers</h3>
          <p class="sub-lede">
            Every executor emits the same in-toto statement. Its tier says what it proves; the verification policy decides
            what counts.
          </p>
          <div class="compare__wrap">
            <table class="compare__table">
              <caption class="sr-only">Provenance tiers, what each proves and where it is used</caption>
              <thead>
                <tr>
                  <th>Tier</th>
                  <th>Proves</th>
                  <th>Used for</th>
                </tr>
              </thead>
              <tbody>
                {
                  tiers.map((t) => (
                    <tr>
                      <td><code>{t.tier}</code></td>
                      <td>{t.proves}</td>
                      <td>{t.use}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="more"><a href="/docs/provenance/">Provenance →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="snippets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§07 / The code</span>
        <h2>One program per run. One policy for where it runs.</h2>
      </div>
      <div class="snippets__widget">
        <div class="snippets__tabs" role="tablist" aria-label="Code samples">
          {
            snippets.map((s, i) => (
              <button
                type="button"
                class="snippets__tab"
                role="tab"
                id={`snippet-tab-${s.id}`}
                aria-controls={`snippet-panel-${s.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                data-tab="snippet"
                data-target={`snippet-panel-${s.id}`}
              >
                {s.label}
              </button>
            ))
          }
        </div>
        {
          snippets.map((s, i) => (
            <div
              class="snippets__panel"
              role="tabpanel"
              id={`snippet-panel-${s.id}`}
              aria-labelledby={`snippet-tab-${s.id}`}
              data-panel="snippet"
              hidden={i !== 0}
            >
              <div class="snippets__blurb">
                <span>{s.blurb}</span>
                <a href={s.href}>Docs →</a>
              </div>
              <Code code={s.code} lang={s.lang} wrap />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§08 / Recipes</span>
        <h2>Gate and agentic recipes ship in the catalog.</h2>
      </div>
      <div class="tenets__grid">
        {
          recipes.map((r) => (
            <a class="tenet tenet--link" href={r.href}>
              <span class="tenet__id">{r.id}</span>
              <h3 class="tenet__title">{r.title}</h3>
              <p class="tenet__rationale">{r.body}</p>
            </a>
          ))
        }
      </div>
    </div>
