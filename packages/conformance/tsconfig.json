{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // mameko exports its TypeScript sources with `.ts` import specifiers. The cache package's R2, D1 and Durable
    // Object types come from the Workers types; mameko's suites type Web Crypto from the DOM library, and the
    // e2e-local stack the GitHub suite starts iterates `Headers`, which DOM.Iterable types.
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
