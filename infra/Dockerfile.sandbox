# FlareDispatch sandbox image — minimal lean variant.
#
# The @cloudflare/sandbox SDK's Sandbox Durable Object speaks an HTTP/RPC
# protocol to a server baked into the container, so the image MUST derive from
# the matching cloudflare/sandbox base (a bare node image has no sandbox
# server). The base already ships Node 22 + git + curl, which is all pr-review
# needs (git checkout + `git diff`). Pin the tag to @cloudflare/sandbox in
# package.json and bump both together.
#
# NOTE: the full image (demo-agent / flare-agent CLIs, chromium + agent build
# variants) is reintroduced when those packages are ported in the parity phase.
FROM docker.io/cloudflare/sandbox:0.10.1

# corepack — the standard bootstrap for repos that pin `"packageManager"`
# (pnpm/yarn). The sandbox base ships Node 22 but WITHOUT corepack on PATH, so
# any consumer command opening with `corepack enable` dies with exit 127 before
# running project code (observed: fractalboxdev/flare-encrypt offload-test —
# `bash: corepack: command not found`). Install it globally and pre-activate the
# shims so both `corepack enable && pnpm …` and bare `pnpm …` bootstraps work.
# `@latest` is deliberate: corepack is a version-resolving shim (the consumer's
# packageManager pin decides the real tool version), so pinning corepack itself
# buys no reproducibility for consumers — the image tag above stays the pin.
RUN npm install -g corepack@latest && corepack enable
