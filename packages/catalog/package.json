{
  "name": "@fractalboxdev/flare-dispatch-catalog",
  "version": "0.0.1",
  "private": true,
  "description": "FlareDispatch's v2 run catalogue: the run declarations the control plane reads, the run bodies the runner child executes, and the device extension.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runs": "./src/runs.ts",
    "./run-digests": "./src/run-digests.json"
  },
  "scripts": {
    "test": "vitest run",
    "gen:schemas": "node --experimental-strip-types --no-warnings src/generate-schemas.ts",
    "gen:run-digests": "node --experimental-strip-types --no-warnings src/generate-run-digests.ts"
  },
  "dependencies": {
    "@fractalboxdev/flare-dispatch-agentic": "workspace:*",
    "@fractalboxdev/flare-dispatch-cache": "workspace:*",
    "@fractalboxdev/flare-dispatch-profile": "workspace:*",
    "@fractalboxdev/mameko-run": "workspace:*",
    "@fractalboxdev/mameko-runner": "workspace:*",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@fractalboxdev/mameko-coordinator": "workspace:*",
    "@fractalboxdev/mameko-host-cloudflare": "workspace:*",
    "@fractalboxdev/mameko-kernel": "workspace:*",
    "@fractalboxdev/mameko-ports": "workspace:*",
    "@types/node": "^22.19.0",
    "fast-check": "^3.23.2",
    "vitest": "^3.2.0"
  }
}
