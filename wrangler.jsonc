{
  // FlareDispatch Dispatcher Worker (new-repo deploy).
  // Non-destructive: distinct name + fresh D1/R2/KV so it never collides with
  // any prior deployment in the same account. Dashboard SPA assets are omitted
  // (the SSR fallback in dashboard.ts serves the routes).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-dispatch",
  "main": "apps/dispatcher/src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },
  "keep_vars": true,

  // Wall-clock dispatch. Each expression must match a registered run's
  // `schedules[].cron` EXACTLY — `schedulesByCron` (apps/dispatcher/src/registry.ts)
  // matches on the literal string, so a cosmetic difference silently fires
  // nothing. `handleScheduled` logs a warning when a cron matches no run,
  // which is the only symptom drift produces.
  //
  // Nothing here fired before this block existed: the runs declared schedules,
  // the `scheduled()` handler was wired and unit-tested, and the Worker was
  // simply never asked to wake up. Three built runs had been producing no
  // signal since they landed.
  "triggers": {
    "crons": [
      "0 5 * * *", // spec-drift-pr  — daily
      "45 5 * * *", // org-spec-audit — daily, after spec-drift-pr
      "0 6 * * *", // ci-triage-pr   — daily
      "0 7 * * 1", // finops-audit   — Mondays
    ],
  },

  // Two further runs declare schedules and are deliberately NOT armed here,
  // because arming them is a product decision rather than a config omission:
  //
  //   "0 9 * * 1"  release-notes — opens a NON-draft PR and holds a 72h human
  //                approval gate. First firing puts a release PR in front of
  //                people who have not agreed to review one weekly.
  //   "0 14 * * *" product-demo  — daily browser-rendering run; its confirmed
  //                failures escalate into self-heal-pr. Recurring spend plus an
  //                auto-PR path, both worth switching on deliberately.
  //
  // Add the expression here when that decision is made; the runs need no change.

  // Custom domain (requires the fractalbox.dev zone in this account). The
  // GitHub App install flow substitutes the request origin into the manifest,
  // so hitting the install page on this host wires the App's webhook/callback
  // URLs to it.
  "routes": [{ "pattern": "flare-dispatch.fractalbox.dev", "custom_domain": true }],

  // Workers AI — backs the modelGateway capability the pr-review engine calls.
  // The binding IS the auth (account-billed), so no model API key is needed.
  "ai": { "binding": "AI" },

  // Browser Rendering — backs GET /v1/browser/cdp (unused by pr-review; kept
  // for parity with the run set).
  "browser": { "binding": "BROWSER" },

  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "c91d52c288c452ab734ede1518b00e11",
    // AI Gateway the modelGateway routes through — REQUIRED for prefixed model
    // ids (`anthropic/*`, `deepseek/*`, `openai/*`, `bedrock/*`), which ride the
    // gateway universal endpoint / Bedrock forwarder. `openai/*` additionally
    // needs unified billing enabled on this gateway (or a stored OpenAI key —
    // mutually exclusive). If the gateway has Authenticated Gateway turned on,
    // also set the AI_GATEWAY_AUTH_TOKEN secret.
    "AI_GATEWAY_ID": "fractalbox-engineering-gateway",
    "ADMISSION_CAP": "16",
    // Opt the human-facing viewer surfaces (incl. the GitHub App install flow)
    // out of the Cloudflare Access gate for the initial dogfood. Configure
    // ACCESS_AUD and drop this to re-gate them. NOTE: the viewer surfaces still
    // need their OWN Access app before flipping this — the deploy app below only
    // path-scopes /deploy. access-auth.ts also reads a single ACCESS_AUD, so
    // gating both surfaces needs multi-audience support first (issue #2).
    "VIEWER_ACCESS_MODE": "token-only",
    // Cloudflare Access team domain (issuer) — shared by the viewer + deploy
    // gates. The deploy console verifies the Access JWT against this + the AUD
    // below, and fetches identity from <issuer>/cdn-cgi/access/get-identity.
    "ACCESS_TEAM_DOMAIN": "fractalbox.cloudflareaccess.com",
    // Deploy console (/deploy) Access application AUD. Distinct from the viewer
    // ACCESS_AUD. The app's policy allows the GitHub `fractalboxdev/devs` team;
    // per-env authorization is CONFIG_KV `deploy.env-authz`. See deploy-access.ts.
    "DEPLOY_ACCESS_AUD": "44c3a07df1b0a4e454b28da9f55e7dbf3e279d1d09274667467a4d41ba79cafe",
    // Execution backend. "on" routes every facade-capable run through the
    // SUBSTRATE binding below; anything else keeps the container path in this
    // config. Flipping it is the cutover — see apps/substrate/specs/adoption-runbook.md.
    // Per-run egress rollout position is a SEPARATE decision, in
    // apps/dispatcher/src/grant-catalog.ts.
    "SUBSTRATE_BACKEND": "off",
  },

  // The substrate facade (apps/substrate/specs/adr/0003-facade-only-consumption.md).
  // `entrypoint` is the consumer identity: the substrate reads no runtime field
  // to decide who is calling, so binding to `DispatcherFacade` here — in
  // reviewed config — is what makes this Worker "the dispatcher" for admission
  // pools, budgets and grant derivation.
  //
  // The substrate worker deploys FIRST; a `wrangler deploy` of this Worker
  // against a missing service fails at bind time rather than at 2am.
  "services": [
    {
      "binding": "SUBSTRATE",
      "service": "flare-dispatch-substrate",
      "entrypoint": "DispatcherFacade",
    },
  ],

  "workflows": [
    {
      "name": "runs-workflow",
      "binding": "RUNS_WORKFLOW",
      "class_name": "RunWorkflow",
    },
  ],

  // ===========================================================================
  // DRAIN TARGET — this block and the three DO classes below it are what the
  // stage-2 exit deletes (apps/substrate/specs/platform.md § Adoption plan:
  // "no `containers` stanza exists in any wrangler config except the
  // substrate's"). It is still here because three runs — `cdp-acceptance`,
  // `product-demo`, `self-heal-pr` — call a detached-process / preview-URL
  // surface the facade does not serve, so deleting it today would strand them
  // rather than move them. `apps/dispatcher/src/grant-catalog.ts` names that
  // per run (`facadeGaps`), and apps/substrate/specs/adoption-runbook.md is
  // the sequence that removes it.
  // ===========================================================================
  //
  // Two Dockerfiles, one per image shape. `Dockerfile.sandbox` (lean:
  // cloudflare/sandbox base + optional build-tools/rust layers) builds the
  // browser/agent classes; `Dockerfile.sandbox-demo` adds the bundled
  // `demo-agent` layer (a node builder stage + smoke test) and builds
  // RunSandbox. The split is deliberate: a lean class build never pulls the
  // node builder stage or ships the bundle, and a dispatch that lands on the
  // wrong class still fails honestly at exec ("No such file or directory").
  //
  // `image_build_context: "."` on RunSandbox is REQUIRED, not cosmetic:
  // wrangler's container build defaults the context to the Dockerfile's own
  // directory (`infra/`), and the demo builder stage COPYs the workspace
  // slice (`packages/demo-agent`, `packages/bedrock-sigv4`, root manifests)
  // from the context — with the default context those paths don't exist and
  // the image build fails at the first COPY. `.` resolves against the
  // wrangler config's directory (the repo root); `.dockerignore` keeps the
  // transfer lean.
  //
  // RunSandbox (the offload-test/check executor + the `product-demo` run's
  // default acquisition — `sandbox.acquire({})` gets the DEFAULT image
  // class) bakes the native toolchain + Rust: webhook-mode runs have no
  // setup step to install one, and consumer Rust workspaces with `*-sys`
  // crates both need `cc` to link and more memory than standard-2 gives a
  // cold `cargo test` of a large dep graph.
  "containers": [
    {
      "class_name": "RunSandbox",
      "image": "./infra/Dockerfile.sandbox-demo",
      "image_build_context": ".",
      "image_vars": { "WITH_BUILD_TOOLS": "true", "WITH_RUST": "true" },
      "instance_type": "standard-4",
      "max_instances": 16,
    },
    {
      "class_name": "RunSandboxBrowser",
      "image": "./infra/Dockerfile.sandbox",
      "instance_type": "standard-2",
      "max_instances": 16,
    },
    {
      "class_name": "RunSandboxAgent",
      "image": "./infra/Dockerfile.sandbox",
      "instance_type": "standard-3",
      "max_instances": 8,
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "RUNS_SANDBOX", "class_name": "RunSandbox" },
      { "name": "RUNS_SANDBOX_BROWSER", "class_name": "RunSandboxBrowser" },
      { "name": "AGENT_BUDGET", "class_name": "AgentBudget" },
      { "name": "RUNS_SANDBOX_AGENT", "class_name": "RunSandboxAgent" },
    ],
  },

  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["RunSandbox"] },
    { "tag": "v1", "new_sqlite_classes": ["RunSandboxBrowser"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentBudget"] },
    { "tag": "v3", "new_sqlite_classes": ["RunSandboxAgent"] },
  ],

  "r2_buckets": [{ "binding": "RUNS_STORAGE", "bucket_name": "flare-dispatch" }],

  "d1_databases": [
    {
      "binding": "RUNS_METADATA",
      "database_name": "flare-dispatch",
      "database_id": "3a365bf1-fae3-4a29-bef7-5b020f8cb283",
      "migrations_dir": "infra/migrations",
    },
  ],

  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "dff3e9657cf34c94955c31a333084f1c",
    },
    {
      "binding": "IDEMPOTENCY_KV",
      "id": "3002db8dac904fc794cf2686fb5dfe57",
    },
  ],
}
