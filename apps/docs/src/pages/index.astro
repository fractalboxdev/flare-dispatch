---
// The page is three pillars: run anywhere, secure, and CI, tasks and agents. It carries no status:
// /roadmap/ reports what exists, and test/specs.test.ts rejects status labels here. So the plain
// present tense states only what exists, and anything else is phrased as design ("designed so
// that", "built to"). A claim that needs a status label to stay true does not belong on this page.
import { Code } from "@astrojs/starlight/components";
import Landing from "../layouts/Landing.astro";
import HeroDiagram from "../components/landing/HeroDiagram.astro";
import Diagram from "../components/landing/Diagram.astro";
import { fencedLease, lifecycle, placement } from "../components/landing/diagrams";

const TITLE = "Run CI, tasks and agents anywhere. Securely. | FlareDispatch";
const DESCRIPTION =
  "Run CI, tasks and agents anywhere. Securely. FlareDispatch is designed to place work on your machines, Cloudflare and other clouds, from your own account.";

const pillars = [
  {
    id: "01.01 / Run anywhere",
    title: "Your machines, Cloudflare, other clouds",
    body: "Built to place each job where it fits: machines you own for routine work, Cloudflare Containers and other cloud executors where capacity matters.",
    href: "#run-anywhere",
  },
  {
    id: "01.02 / Secure",
    title: "Signed requests, fenced results",
    body: "The Dispatcher verifies every dispatch and webhook signature. The device path is designed so that a machine proves its key and a stale result never counts.",
    href: "#secure",
  },
  {
    id: "01.03 / CI, tasks and agents",
    title: "Three kinds of work, one run contract",
    body: "Gates and test suites, scheduled tasks and model-driven agents are all typed programs, with the same triggers, durable steps and logs.",
    href: "#work",
  },
];

const wins = [
  { dim: "Warm state: deps, builds, browsers", owned: "Stays on local disk between runs", cloud: "Starts cold each execution", verdict: "Owned" },
  { dim: "Burst fan-out", owned: "Fixed slot count", cloud: "Up to the pool's admission cap", verdict: "Cloud" },
  { dim: "Untrusted code (fork PRs)", owned: "Not eligible", cloud: "Disposable container", verdict: "Cloud only" },
  { dim: "Releases", owned: "Not eligible", cloud: "Cold from the commit", verdict: "Cloud only" },
];

const rules = [
  {
    title: "Designed so that fork PR code stays off owned hardware.",
    body: "Owned devices are meant for code from people with write access.",
  },
  {
    title: "Designed so that releases build in the cloud.",
    body: "A release starts cold from the commit, on a disposable executor.",
  },
  {
    title: "Designed so that one copy runs.",
    body: "Owned-first placement is a delayed cloud claim, not a race: the first claim wins the epoch.",
  },
];

const queue = [
  { title: "Named reasons.", body: "A red check is designed to say why it is red: budget, capacity, deadline or halt." },
  { title: "Four classes.", body: "Work is designed to carry a class, from release to batch, that decides how long it waits." },
  { title: "One verdict.", body: "The check is designed to report the result of the current epoch only." },
];

const secure = [
  {
    id: "03.01 / Requests",
    title: "Signed triggers",
    body: "The Dispatcher verifies the HMAC signature of each dispatch and webhook. Log links carry a signed token, and Cloudflare Access gates the dashboard.",
  },
  {
    id: "03.02 / Machines",
    title: "Device identity",
    body: "Designed so that a machine enrolls by key and signs each connection, and the control plane verifies the signature against the enrolled key.",
  },
  {
    id: "03.03 / Credentials",
    title: "Least privilege",
    body: "Designed so that a job holds no secret of the executor's. An optional substrate runs containers with no internet access and grants egress through reviewed profiles.",
  },
];

const work = [
  {
    id: "04.01 / CI",
    title: "check, oxlint, offload-test",
    body: "check runs one repository-chosen command in a container and reports a check run. oxlint is the install-free Oxc gate. offload-test runs a suite and uploads its log to R2.",
  },
  {
    id: "04.02 / CI",
    title: "playwright-e2e, matrix-fanout",
    body: "playwright-e2e runs one container per shard against Cloudflare Browser Rendering. matrix-fanout and vitest-shard split a suite across containers.",
  },
  {
    id: "04.03 / Tasks",
    title: "finops-audit, product-demo",
    body: "A task here is a run that gates nothing. finops-audit runs weekly on a cron schedule and proposes a draft PR; product-demo records a demo daily.",
  },
  {
    id: "04.04 / Tasks",
    title: "refresh-fixtures",
    body: "refresh-fixtures regenerates files in a credential-free container, then the Worker proposes the diff as a PR.",
  },
  {
    id: "04.05 / Agents",
    title: "pr-review",
    body: "A Worker-side review engine calls a model through the model gateway capability and reviews a pull request.",
  },
  {
    id: "04.06 / Agents",
    title: "self-heal-pr, ci-triage-pr, spec-drift-pr",
    body: "self-heal-pr runs a coding agent in a credential-free sandbox, re-runs the repro and opens a draft PR only when the repro goes green.",
  },
];

const bets = [
  {
    statement: "Cloudflare <strong>schedules</strong>; machines execute.",
    body: "The control plane is designed to own every guarantee, deadline and check, so a device's uptime never becomes the system's.",
  },
  {
    statement: "<strong>Queue</strong>, then fail.",
    body: "Designed so that a budget, capacity, deadline or halt outcome never concludes success or neutral.",
  },
  {
    statement: "Runs are <strong>typed programs</strong>, not YAML.",
    body: "A run is an Effect program with schema-typed inputs, durable steps and tagged errors.",
  },
  {
    statement: "BYOC <strong>by construction</strong>.",
    body: "Each organization deploys its own Dispatcher into its own Cloudflare account. There is no multi-tenant service to trust.",
  },
];

const checkTs = `// runs/check.ts, condensed
export const check = defineRun({
  name: "check",
  inputs: CheckInput,
  outputs: CheckOutput,
  run: (input) =>
    Effect.gen(function* () {
      const { container, dir } = yield* step("checkout", () =>
        workspace({ repo: input.repo, sha: input.sha, image: input.image, install: input.install }),
      );
      const { result } = yield* durableExec({ name: "exec", workspace: { container, dir }, exec });
      const logUri = yield* step("upload-log", () =>
        artifact.upload({ name: "check.log", path: result.logPath, signedUrlTTL: "30 days" }),
      );
      return { exitCode: result.exitCode, durationMs: result.durationMs, logUri };
    }),
});`;

const snippets = [
  {
    id: "check",
    label: "check.ts",
    code: checkTs,
    blurb: "A run is a typed program: durable steps, a container workspace and a log in R2.",
    href: "/docs/runs/",
    link: "Run catalog →",
  },
];
---

<Landing title={TITLE} description={DESCRIPTION}>
  <section class="hero">
    <div class="container">
      <div class="hero__meta">
        <span class="section-marker reveal" data-delay="1">§00 / Manifest</span>
        <span class="section-marker reveal" data-delay="1">BYOC · open source</span>
      </div>
      <div class="hero__grid">
        <div>
          <h1 class="hero__title reveal" data-delay="2">
            Run CI, tasks and agents <em>anywhere</em>. Securely.
          </h1>
          <p class="hero__sub reveal" data-delay="3">
            FlareDispatch is built to run CI, scheduled tasks and agents on your own machines, on Cloudflare and on
            other cloud executors, from a control plane you deploy into your own account.
          </p>
          <div class="hero__cta reveal" data-delay="4">
            <a class="btn" href="/docs/">Read the docs</a>
            <a class="btn btn--ghost" href="/specs/">Read the specs</a>
            <a class="btn btn--ghost" href="/specs/adr/">Decision records</a>
          </div>
          <p class="more reveal" data-delay="4"><a href="/roadmap/">Roadmap and status →</a></p>
        </div>
        <div class="reveal" data-delay="3">
          <HeroDiagram />
        </div>
      </div>
    </div>
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§01 / Three pillars</span>
        <h2>Where work runs, how it stays safe, and what it can be.</h2>
        <p class="section-lede">
          FlareDispatch is CI/CD you deploy into your own Cloudflare account. Its design builds on
          <a href="https://github.com/fractalboxdev/mameko">mameko</a>, the libraries that accept work, select an
          executor and record results.
        </p>
      </div>
      <div class="tenets__grid">
        {
          pillars.map((p) => (
            <a class="tenet tenet--link" href={p.href}>
              <span class="tenet__id">{p.id}</span>
              <h3 class="tenet__title">{p.title}</h3>
              <p class="tenet__rationale">{p.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tenets" id="run-anywhere">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§02 / Run anywhere</span>
        <h2>Your own machines, Cloudflare and other cloud executors.</h2>
        <p class="section-lede">
          An ephemeral runner re-downloads dependencies and rebuilds unchanged packages on every job. The design keeps
          that state warm on machines you own and uses the cloud for what those machines cannot do.
        </p>
      </div>
      <div class="compare__wrap compare__wrap--spaced">
        <table class="compare__table">
          <caption class="sr-only">How the design divides work between owned hardware and the cloud</caption>
          <thead>
            <tr>
              <th>Dimension</th>
              <th>Owned hardware</th>
              <th>Cloudflare Containers</th>
              <th>Designed to run on</th>
            </tr>
          </thead>
          <tbody>
            {
              wins.map((w) => (
                <tr>
                  <td>{w.dim}</td>
                  <td>{w.owned}</td>
                  <td>{w.cloud}</td>
                  <td class:list={[w.verdict === "Owned" ? "compare__yes" : "compare__cloud"]}>{w.verdict}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§02.1 / Placement</span>
        <h2>Placement is designed so that rules hold before any deadline does.</h2>
        <p class="section-lede">
          In the design, rules remove executors from the eligible set first; a deadline then decides between owned
          hardware and the cloud.
        </p>
      </div>
      <div class="split">
        <Diagram id="placement" source={placement} width={520} caption="Fig. 1 · the design: rules first, then the deadline" />
        <div>
          <ol class="rules">
            {
              rules.map((r, i) => (
                <li class="rule-item">
                  <span class="rule-item__num">§02.1.{i + 1}</span>
                  <div>
                    <p class="rule-item__title">{r.title}</p>
                    <p class="rule-item__body">{r.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="more">
            <a href="/specs/profile/">Profile and placement →</a>
            <a href="/specs/executors/">Executors →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§02.2 / Queue, then fail</span>
        <h2>Designed so that no budget or capacity outcome turns a check green.</h2>
        <p class="section-lede">
          GitHub counts a <code>neutral</code> conclusion as passing for a required check, so the design waits, then
          fails with a reason, rather than concluding <code>neutral</code>.
        </p>
      </div>
      <div class="split split--reverse">
        <div>
          <ul class="facts">
            {
              queue.map((q) => (
                <li>
                  <strong>{q.title}</strong> {q.body}
                </li>
              ))
            }
          </ul>
          <p class="more">
            <a href="/specs/profile/">Classes and admission →</a>
            <a href="/specs/github-output/">GitHub output →</a>
          </p>
        </div>
        <Diagram id="lifecycle" source={lifecycle} width={560} caption="Fig. 2 · the design: an execution, intake to verdict" />
      </div>
    </div>
  </section>

  <section class="tenets" id="secure">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§03 / Secure</span>
        <h2>Dispatches and webhooks prove who sent them.</h2>
        <p class="section-lede">
          The Dispatcher runs in your account, and it rejects a dispatch or webhook whose signature does not verify.
          The design extends the same rule to machines.
        </p>
      </div>
      <div class="tenets__grid">
        {
          secure.map((s) => (
            <article class="tenet">
              <span class="tenet__id">{s.id}</span>
              <h3 class="tenet__title">{s.title}</h3>
              <p class="tenet__rationale">{s.body}</p>
            </article>
          ))
        }
      </div>
      <p class="more">
        <a href="/specs/isolation-egress/">Isolation and egress design →</a>
        <a href="/docs/substrate/grant-profiles/">Grant profiles →</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§03.1 / Fenced leases</span>
        <h2>Designed so that a lost machine costs time, never a wrong check.</h2>
        <p class="section-lede">
          A lease carries an epoch. The design reclaims a lease when its heartbeat stops, restarts the work under the
          next epoch and accepts a result only at the current one.
        </p>
      </div>
      <div class="split">
        <Diagram id="fenced-lease" source={fencedLease} width={560} caption="Fig. 3 · the design: reclaim, restart, reject the stale result" />
        <div>
          <p class="more">
            <a href="/specs/executor-protocol/">Executor protocol →</a>
            <a href="/specs/adr/0007-fenced-execution-leases/">Why fenced leases →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="tenets" id="work">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§04 / CI, tasks and agents</span>
        <h2>Gates, scheduled tasks and agents share one run contract.</h2>
        <p class="section-lede">
          The catalog defines all three kinds of work through one <code>defineRun</code> contract, on the same trigger
          sources and durable steps.
        </p>
      </div>
      <div class="tenets__grid">
        {
          work.map((r) => (
            <a class="tenet tenet--link" href="/docs/runs/">
              <span class="tenet__id">{r.id}</span>
              <h3 class="tenet__title">{r.title}</h3>
              <p class="tenet__rationale">{r.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="snippets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§04.1 / The code</span>
        <h2>One program per run.</h2>
      </div>
      <div class="snippets__widget">
        <div class="snippets__tabs" role="tablist" aria-label="Code samples">
          {
            snippets.map((s, i) => (
              <button
                type="button"
                class="snippets__tab"
                role="tab"
                id={`snippet-tab-${s.id}`}
                aria-controls={`snippet-panel-${s.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                data-tab="snippet"
                data-target={`snippet-panel-${s.id}`}
              >
                {s.label}
              </button>
            ))
          }
        </div>
        {
          snippets.map((s, i) => (
            <div
              class="snippets__panel"
              role="tabpanel"
              id={`snippet-panel-${s.id}`}
              aria-labelledby={`snippet-tab-${s.id}`}
              data-panel="snippet"
              hidden={i !== 0}
            >
              <div class="snippets__blurb">
                <span>{s.blurb}</span>
                <a href={s.href}>{s.link}</a>
              </div>
              <Code code={s.code} lang="ts" wrap />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="container">
      <div class="manifesto__header">
        <span class="section-marker">§05 / Design philosophy</span>
        <h2>Four bets the design rests on.</h2>
      </div>
      <ol class="manifesto__list">
        {
          bets.map((b, i) => (
            <li class="manifesto__item">
              <span class="manifesto__num">§05.0{i + 1}</span>
              <div>
                <p class="manifesto__statement" set:html={b.statement} />
                <p class="manifesto__body">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container">
    <div class="cta-band">
      <div>
        <span class="section-marker">§06 / Start</span>
        <h2>One Dispatcher per organization, in your own Cloudflare account.</h2>
      </div>
      <div class="cta-band__actions">
        <a class="btn" href="/docs/">Read the docs</a>
        <a class="btn btn--ghost" href="/specs/">Read the specs</a>
        <a class="btn btn--ghost" href="/benchmarks/">Modeled run costs</a>
      </div>
    </div>
  </section>

  <script>
    // Tabs: a tab carries data-tab="<group>" and data-target="<panel id>"; its panels carry
    // data-panel="<group>".
    for (const tab of document.querySelectorAll<HTMLElement>("[data-tab]")) {
      tab.addEventListener("click", () => {
        const group = tab.dataset.tab;
        for (const t of document.querySelectorAll(`[data-tab="${group}"]`)) {
          t.setAttribute("aria-selected", String(t === tab));
        }
        for (const p of document.querySelectorAll<HTMLElement>(`[data-panel="${group}"]`)) {
          p.toggleAttribute("hidden", p.id !== tab.dataset.target);
        }
      });
    }
  </script>
</Landing>
