{
  // The v2 control plane. `DEPLOYMENT` is `production` here, and only the local CI command overrides it, so a
  // deploy of this file refuses host execution and the software key. Every account-specific value is a `{{path}}`
  // placeholder the renderer fills from the operator overlay; secrets (the App key, webhook secret, link key, cache
  // token secrets, the presigner's R2 API token, the log key, the records signing key) are Worker secrets.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flare-dispatch-control-plane",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "keep_vars": false,
  // No container runs locally: the cloud pools need host-cloudflare's launcher, so `wrangler dev` builds no image.
  "dev": { "enable_containers": false },
  "routes": [{ "pattern": "{{hostnames.dispatcher}}", "custom_domain": true }],
  "vars": {
    "DEPLOYMENT": "production",
    // The plane id every device's `connect` signature binds (FD-IFC-085).
    "PLANE_ID": "{{executors.planeId}}",
    "ALERT_SINK": "{{alerts.sink}}",
    "ACCESS_TEAM_DOMAIN": "{{access.teamDomain}}",
    "ACCESS_AUD": "{{access.aud}}",
    "OPERATORS": "{{operators}}",
    // The identities allowed to dispatch through `fd` and `/mcp`, none where the overlay names none (FD-IFC-027).
    "DISPATCHERS": "{{dispatchers}}",
    // The identities the tightening operator routes admit, none where the overlay names none (FD-IFC-095).
    "CONTAINMENT": "{{containment}}",
    // The Actions OIDC audience of a dispatch; empty where the overlay sets none, which refuses every Actions token.
    "DISPATCH_OIDC_AUDIENCE": "{{dispatch.oidcAudience}}",
    // The `dispatch.scoped` entries `{ identity, runs, repositories, classCeiling }`, none where the overlay names none:
    // each identity dispatches only its entry's runs to its entry's repositories (FD-IFC-089, FD-IFC-090).
    "DISPATCH_SCOPED": "{{dispatch.scoped}}",
    // The webhook events intake admits: `null` where the overlay sets no list, which admits every supported event,
    // and `[]` for an empty list, which admits none (FD-INT-027).
    "WEBHOOK_EVENTS": "{{intake.webhookEvents}}",
    "GITHUB_APP_ID": "{{github.appId}}",
    // The App's slug: its bot `<slug>[bot]` authors the release pull requests intake approves (FD-INT-066) and every
    // App commit and comment. Without it the control plane applies nothing to GitHub.
    "GITHUB_APP_SLUG": "{{github.appSlug}}",
    // The repository the 15-minute synthetic webhook canary pushes to; with the App's key, the tick also runs the
    // installation and delivery probes (FD-OPS-038, FD-OPS-041, FD-OPS-044).
    "GITHUB_FIXTURE_REPO": "{{github.fixtureRepo}}",
    // The overlay's spend values in USD, each it leaves out at its default: `B`, `F`, the release reserve, `R_ops`,
    // `R_m,min`, `D` and the overhead factor the spend view reads (FD-PROF-054).
    "SPEND": "{{spend}}",
    // The overlay's policy rules per repository, which the fd deploy drift stage synced: class rules and each
    // repository's confidentiality mode (FD-PROF-025).
    "POLICY_RULES": "{{policy.rules}}",
    // The overlay's `attestation_max_age` in days, 10 where it sets none: the result-acceptance check rejects a
    // statement from a device whose last attestation is older (FD-PROV-016).
    "ATTESTATION_MAX_AGE_DAYS": "{{provenance.attestationMaxAgeDays}}",
    // The pinned scan bundle's SHA-256, empty where the overlay pins none: the digest a `security-gate` or
    // `security-rescan` scan checks the bundle at `cas/<digest>` against (FD-GATE-100), and reads as unpinned where
    // empty (FD-GATE-101). A deploy whose drift check fails changes no var, so the deployed pin stays the previous one
    // (FD-OPS-095). No executor serves the scan runs yet (specs/runs/gate.md § Open items).
    "SCAN_BUNDLE_DIGEST": "{{scan.bundleDigest}}",
    // The overlay's statement retention in days, 400 where it sets none: logging a statement keeps each artifact it
    // names until the statement's integrated time plus this many days (FD-PROV-075).
    "STATEMENT_RETENTION_DAYS": "{{provenance.statementRetentionDays}}",
    // The OSV ecosystems whose `all.zip` archive the tick's `advisory-refresh` step stores in `cas/<sha256>` once per
    // UTC day, none where the overlay sets none (FD-OPS-100).
    "ADVISORY_ECOSYSTEMS": "{{scan.advisoryEcosystems}}",
    // The HTTPS URL that receives job and verdict records, empty where the overlay sets none; set, the profile
    // declares `job.record` and `verdict.record` from phase 2, signed under the Worker secret `RECORDS_SIGNING_KEY`
    // (FD-GH-093, FD-GH-099).
    "RECORDS_URL": "{{records.url}}",
    // The advisory snapshot age in hours, 48 where the overlay sets none: the tick pages `advisory-snapshot-stale`
    // while an ecosystem's snapshot is older or missing (FD-OPS-103).
    "ADVISORY_MAX_AGE_HOURS": "{{scan.advisoryMaxAgeHours}}",
    // The object-store presigner signs on `<account_id>.r2.cloudflarestorage.com`, never the custom domain, under
    // the `CACHE` bucket's name. Its R2 API token, scoped to the cache and artifact buckets with Object Read & Write
    // and used for nothing else, is the Worker secrets `R2_PRESIGN_ACCESS_KEY_ID` and `R2_PRESIGN_SECRET_ACCESS_KEY`
    // (FD-CACHE-091).
    "R2_ACCOUNT_ID": "{{accountId}}",
    "CACHE_BUCKET_NAME": "{{r2.CACHE}}",
  },
  // The minute tick (FD-INT-050): outbox drain, liveness, the enqueue of intake's units, the retention sweeps and the
  // daily advisory refresh.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flare-dispatch-control-plane",
      "database_id": "{{d1.DB}}",
    },
  ],
  // The profile document and the runtime configuration.
  "kv_namespaces": [{ "binding": "CONFIG", "id": "{{kv.CONFIG}}" }],
  // `CACHE` holds the cache, compile cache, artifacts and logs under their prefixes (FD-CACHE-091).
  "r2_buckets": [
    { "binding": "CACHE", "bucket_name": "{{r2.CACHE}}" },
    { "binding": "ARTIFACTS", "bucket_name": "{{r2.ARTIFACTS}}" },
  ],
  // The `ExecutionEngine` object calls this Worker's own `MamekoDrain` entrypoint when an execution settles, so its
  // outcome rows go out then rather than at the next tick (MAMEKO-HOST-064). The service is this Worker's name.
  "services": [
    {
      "binding": "MAMEKO_DRAIN",
      "service": "flare-dispatch-control-plane",
      "entrypoint": "MamekoDrain",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL", "class_name": "ExecutorChannel" },
      { "name": "EXECUTION", "class_name": "ExecutionEngine" },
      { "name": "EPOCH_ANCHOR", "class_name": "EpochAnchor" },
      { "name": "MONITOR", "class_name": "LivenessMonitor" },
      { "name": "CACHE_LEDGER", "class_name": "CacheLedger" },
      { "name": "POOL_CONTROLLER", "class_name": "PoolController" },
      { "name": "INSTALLATION_QUOTA", "class_name": "InstallationQuota" },
      { "name": "LEAN_POOL", "class_name": "LeanPool" },
      { "name": "AGENT_POOL", "class_name": "AgentPool" },
      { "name": "BROWSER_POOL", "class_name": "BrowserPool" },
      { "name": "RELEASE_POOL", "class_name": "ReleasePool" },
      { "name": "CONTROL_POOL", "class_name": "ControlPool" },
      // One per GitHub App installation: its tick units, one per alarm (FD-INT-067).
      { "name": "INTAKE_UNITS", "class_name": "IntakeUnits" },
      // The only writer of the private transparency log: one object, `idFromName("private")`, writing to `CACHE`
      // under `tlog/private/` and signing checkpoints with the `LOG_KEY` Worker secret (FD-PROV-074).
      { "name": "TRANSPARENCY_LOG", "class_name": "TransparencyLog" },
    ],
  },
  // One Container class per cloud pool, each running the gate image; `max_instances` sits above the pool's admission
  // cap in the profile (FD-ARCH-001).
  "containers": [
    {
      "class_name": "LeanPool",
      "image": "../../infra/v2/Dockerfile.gate",
      "image_build_context": "../..",
      "max_instances": 64,
    },
    {
      "class_name": "AgentPool",
      "image": "../../infra/v2/Dockerfile.gate",
      "image_build_context": "../..",
      "max_instances": 16,
    },
    {
      "class_name": "BrowserPool",
      "image": "../../infra/v2/Dockerfile.gate",
      "image_build_context": "../..",
      "max_instances": 32,
    },
    {
      "class_name": "ReleasePool",
      "image": "../../infra/v2/Dockerfile.gate",
      "image_build_context": "../..",
      "max_instances": 16,
    },
    {
      "class_name": "ControlPool",
      "image": "../../infra/v2/Dockerfile.gate",
      "image_build_context": "../..",
      "max_instances": 32,
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ExecutorChannel",
        "ExecutionEngine",
        "EpochAnchor",
        "LivenessMonitor",
      ],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "CacheLedger",
        "PoolController",
        "InstallationQuota",
        "LeanPool",
        "AgentPool",
        "BrowserPool",
        "ReleasePool",
        "ControlPool",
      ],
    },
    { "tag": "v3", "new_sqlite_classes": ["IntakeUnits"] },
    { "tag": "v4", "new_sqlite_classes": ["TransparencyLog"] },
  ],
}
