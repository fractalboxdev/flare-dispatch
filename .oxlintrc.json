{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/.wrangler/**",
    "**/.tmp/**",
    ".worktrees/**",
    ".claude/**",
    "**/*.tsbuildinfo",
    "actions/flare-dispatch-action/dist/**",
    "apps/docs/**",
    "apps/dashboard/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "overrides": [
    {
      "files": ["apps/dispatcher/**", "runs/**", "packages/**", "actions/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/substrate/src/**", "**/apps/substrate/**", "../**/substrate/**"],
                "message": "Import @fractalboxdev/flare-dispatch-substrate-contract instead — consumers reach the substrate only through the facade contract, never by path into its internals (ADR-0002, ADR-0003)."
              }
            ]
          }
        ]
      }
    }
  ]
}
